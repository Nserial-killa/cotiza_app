# Copiar este archivo a ".env" y ajustar valores reales.
# El ".env" real NUNCA se sube al repositorio (ver .gitignore).

POSTGRES_USER=cotiza_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cotiza
POSTGRES_PORT=5432

API_PORT=8080
ENV=development

# Mailpit SOLO captura correos de prueba; NO los entrega a Gmail u otros
# destinatarios. Para envíos reales sustituya SMTP_HOST/PORT/USER/PASSWORD/FROM
# por los datos del proveedor SMTP autorizado y use PUBLIC_BASE_URL HTTPS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cotiza@localhost.test
PUBLIC_BASE_URL=http://localhost:8080
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# PDF de la oferta (Gotenberg). Con Docker no hace falta tocarlas: el api
# llama a Gotenberg por la red interna y Gotenberg vuelve al api como
# "api:8080". Si se dejan vacías, el endpoint del PDF responde 503.
GOTENBERG_URL=http://gotenberg:3000
PDF_INTERNAL_BASE_URL=http://api:8080

# Usado por migration-python al importar los Excel/Sheets actuales
SHEETS_EXPORT_PATH=./migration-python/data
