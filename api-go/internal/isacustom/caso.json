    {"codigo":"TOTAL_MENSUAL","operacion":"SUMA","operandos":["PRECIO_CHAT","PRECIO_VOZ","PRECIO_CANALES","PRECIO_INTEGRACIONES","CONSUMO_EXTRA_CHAT","CONSUMO_EXTRA_VOZ"]},
